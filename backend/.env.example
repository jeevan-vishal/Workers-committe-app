# Get these from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key   # keep secret, backend only

# Firebase Cloud Messaging service account JSON (as a single-line string), for push notifications
FCM_CREDENTIALS_JSON={"type":"service_acco`unt","project_id":"..."}

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
